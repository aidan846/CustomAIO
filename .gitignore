# Rust build output. This is the "build folder" - it is large, entirely
# regenerated by `cargo build`, and must never be committed.
/target

# Runtime output: rendered frames, logs, the remembered profile, and the
# backup of any scheduled task setup.bat replaced. All machine-local.
/data

# The binary setup.bat copies up from target\release.
/fan.exe

# Editor and OS noise
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
